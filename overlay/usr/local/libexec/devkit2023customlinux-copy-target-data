#!/bin/bash
set -Eeuo pipefail

runtime_firmware=/run/devkit2023customlinux/windows-firmware
runtime_provenance="$runtime_firmware/provenance.jsonl"
live_bluetooth=/var/lib/devkit2023customlinux
driver_validator=/usr/local/libexec/devkit2023customlinux-validate-windows-driver
bluetooth_helper=/usr/local/libexec/devkit2023customlinux-bluetooth-address
target_root="${1:-}"
active_temporary=

cleanup() {
    if [[ -n "$active_temporary" ]]; then
        rm -f -- "$active_temporary" 2>/dev/null || true
        active_temporary=
    fi
}
trap cleanup EXIT

atomic_install() {
    local source="$1" destination="$2" mode="$3" directory basename
    directory="$(dirname -- "$destination")"
    basename="$(basename -- "$destination")"
    [[ -d "$directory" && ! -L "$directory" ]]
    [[ -f "$source" && ! -L "$source" ]]
    active_temporary="$(mktemp --tmpdir="$directory" ".${basename}.new.XXXXXX")"
    install -m "$mode" "$source" "$active_temporary"
    sync -f "$active_temporary"
    mv -f -- "$active_temporary" "$destination"
    active_temporary=
    sync -f "$directory"
}

[[ "${EUID:-$(id -u)}" -eq 0 ]] || exit 1
[[ -n "$target_root" && "$target_root" == /* && "$target_root" != / ]]
[[ -d "$target_root/etc" && -d "$target_root/usr/lib/firmware" ]]
[[ -f "$runtime_provenance" && ! -L "$runtime_provenance" ]]
[[ "$(stat -c %u "$runtime_provenance" 2>/dev/null)" == 0 ]]
[[ "$(stat -c %a "$runtime_provenance" 2>/dev/null)" == 600 ]]
"$driver_validator" --verify-provenance \
    "$runtime_firmware" "$runtime_provenance"
"$bluetooth_helper" --check-ready

target_firmware="$target_root/usr/lib/firmware/qcom/sc8280xp/microsoft/blackrock"
target_state="$target_root/var/lib/devkit2023customlinux"
target_provenance="$target_state/windows-firmware-provenance.jsonl"
install -d -m 0755 "$target_firmware"
install -d -m 0700 "$target_state"
[[ ! -L "$target_firmware" && ! -L "$target_state" ]]

# Publish each payload by rename, validate the complete set, then commit the
# matching provenance record last. An interrupted copy can never retain a
# provenance record which validates a partially updated set.
for name in qcadsp8280.mbn qccdsp8280.mbn qcdxkmsuc8280.mbn; do
    atomic_install "$runtime_firmware/$name" "$target_firmware/$name" 0644
done
"$driver_validator" --verify-provenance \
    "$target_firmware" "$runtime_provenance"
atomic_install "$runtime_provenance" "$target_provenance" 0600
"$driver_validator" --verify-provenance \
    "$target_firmware" "$target_provenance"

for state_name in bluetooth-address bluetooth-address-source hardware-identity; do
    state_path="$live_bluetooth/$state_name"
    [[ -f "$state_path" && ! -L "$state_path" ]]
    [[ "$(stat -c %u "$state_path" 2>/dev/null)" == 0 ]]
    [[ "$(stat -c %a "$state_path" 2>/dev/null)" == 600 ]]
    atomic_install "$state_path" "$target_state/$state_name" 0600
done
